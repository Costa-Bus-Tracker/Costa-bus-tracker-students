# Variables de entorno — Costa Bus Tracker
#
# Plantilla de referencia. Copia las variables necesarias a backend/.env
# o frontend/.env según corresponda. NO subas tus archivos .env reales a Git.

# --------------------------------------------------------------------------
# BACKEND (backend/.env — Node.js: Express + Socket.io)
# --------------------------------------------------------------------------
# Puerto HTTP del servidor (en local usa 3001 por defecto)
PORT=3001

# Origen permitido por CORS (en local se puede omitir para permitir "*")
# FRONTEND_URL=https://costa-bus-tracker.netlify.app

# Contraseña para el panel de administración (AdminLogin)
ADMIN_PASSWORD=

# Llave secreta compartida con AWS Lambda para validar el header x-api-key
AWS_WEBHOOK_SECRET=

# --------------------------------------------------------------------------
# FRONTEND (frontend/.env — Vite)
# --------------------------------------------------------------------------
# URL pública del backend (si se omite, en local usa http://localhost:3001)
# VITE_BACKEND_URL=https://tu-backend.up.railway.app